# NVIDIA API key for AI insights (site summary + per-page tips)
# Model: nvidia/nemotron-3.5-lightning-30b-a3b
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Google PageSpeed Insights API key (Lighthouse lab data + Chrome UX Report)
# Enable "PageSpeed Insights API" in Google Cloud, then create an API key.
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED-INSIGHTS-API=your_pagespeed_api_key_here
